{
  "tests": [
    {
      "name": "Список вопросов",
      "method": "GET",
      "path": "/?kind=questions&action=list",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Список заявок",
      "method": "GET",
      "path": "/?kind=requests&action=list",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Создать вопрос",
      "method": "POST",
      "path": "/?kind=questions&action=create",
      "body": {"author": "Тест Пользователь", "text": "Тестовый вопрос?"},
      "expectedStatus": 200,
      "expectedBody": {"author": "Тест Пользователь", "answered": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Создать заявку",
      "method": "POST",
      "path": "/?kind=requests&action=create",
      "body": {"author": "Тест Заявитель", "text": "Тестовая проблема"},
      "expectedStatus": 200,
      "expectedBody": {"answered": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Список участников",
      "method": "GET",
      "path": "/?kind=members&action=list",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Добавить участника",
      "method": "POST",
      "path": "/?kind=members&action=create",
      "body": {"name": "Тест Участник", "role": "Модератор", "is_moderator": true},
      "expectedStatus": 200,
      "expectedBody": {"name": "Тест Участник", "is_moderator": true},
      "bodyMatcher": "partial"
    }
  ]
}